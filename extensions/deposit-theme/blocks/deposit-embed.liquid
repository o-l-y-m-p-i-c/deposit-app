{% comment %}
  Deposit app embed block — injects the deposit price script globally.
  This script finds price elements on the storefront and appends deposit text
  only to eligible products. Activated from Theme Settings > App embeds.
{% endcomment %}

{%- assign deposit_config = app.metafields["$app:deposit"]["display-config"].value -%}
<script id="deposit-config" type="application/json">{{ deposit_config | json }}</script>
{%- comment -%}
  Money formats tell deposit-embed.js which currency markers the theme
  renders next to prices; price_selector optionally pins the element.
{%- endcomment -%}
<script id="deposit-theme-settings" type="application/json">
  {
    "moneyFormats": [{{ shop.money_format | json }}, {{ shop.money_with_currency_format | json }}],
    "priceSelector": {{ block.settings.price_selector | default: "" | json }}
  }
</script>

{%- if deposit_config.enabled and deposit_config.mode == "line" and deposit_config.depositVariantId -%}
{%- comment -%}
  Line mode only (stores where the Cart Transform can't run): the
  storefront script maintains a separate deposit line. Hide its controls
  at parse time — before deposit-embed.js loads — so they never flash.
  In expand mode the script never syncs the cart, so no overlay.
{%- endcomment -%}
<script>
  // Inline failsafe: lift the loading overlay even if deposit-embed.js
  // is blocked, fails to load, or throws before its own failsafe runs
  setTimeout(function () {
    document.documentElement.classList.add("deposit-ready");
  }, 4000);
</script>
{%- comment -%}
  Deposit variants in this cart: the shared one plus any per-drink
  deposit line (linked by _deposit_for). Dawn puts
  data-quantity-variant-id on the quantity <input> (newer versions) or
  on <quantity-input> (older ones) — match the row either way.
{%- endcomment -%}
{%- capture deposit_ids -%}
  {{- deposit_config.depositVariantId -}}
  {%- for item in cart.items -%}
    {%- if item.properties._deposit_for -%},{{ item.variant_id }}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign deposit_ids = deposit_ids | split: "," | uniq -%}
<style>
  {%- for id in deposit_ids %}
  .cart-item:has([data-quantity-variant-id="{{ id }}"]) :is(quantity-popover, quantity-input, cart-remove-button, .quantity-popover-container)
    {%- unless forloop.last -%},{%- endunless -%}
  {%- endfor %} {
    display: none !important;
  }

  /* Loading state while deposit-embed.js hasn't run its first sync
     yet — lifted when the script sets html.deposit-ready */
  @keyframes deposit-spin { to { transform: rotate(360deg); } }

  /* Header cart bubble: number hidden, spinner inside the bubble */
  html:not(.deposit-ready) .cart-count-bubble > span { visibility: hidden !important; }
  html:not(.deposit-ready) .cart-count-bubble::after {
    content: ""; position: absolute; top: 50%; left: 50%;
    width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,.4); border-top-color: currentColor;
    animation: deposit-spin .8s linear infinite;
  }

  /* Cart page: overlay only the items table (.cart__contents) */
  html:not(.deposit-ready) .cart__contents,
  html:not(.deposit-ready) cart-drawer-items { position: relative; }
  html:not(.deposit-ready) .cart__contents::after,
  html:not(.deposit-ready) cart-drawer-items::after {
    content: ""; position: absolute; inset: 0; z-index: 10;
    background: rgba(255,255,255,.55); pointer-events: all;
  }
  html:not(.deposit-ready) .cart__contents::before,
  html:not(.deposit-ready) cart-drawer-items::before {
    content: ""; position: absolute; z-index: 11;
    top: 50%; left: 50%; margin: -13px 0 0 -13px;
    width: 26px; height: 26px; border-radius: 50%;
    border: 3px solid rgba(0,0,0,.12); border-top-color: rgba(0,0,0,.55);
    animation: deposit-spin .8s linear infinite;
  }
</style>
{%- endif -%}

{%- comment -%}
  Seed deposit units for the current product and cart lines from the
  $app:deposit.bottles metafield, so the script needs no proxy call for
  them. Only positive values are emitted — a product missing here is
  looked up through the app proxy, never assumed deposit-free.
{%- endcomment -%}
{%- capture deposit_bottles -%}
  {%- if product -%}
    {%- assign b = product.metafields["$app:deposit"].bottles.value -%}
    {%- if b > 0 -%}"{{ product.id }}":{{ b }},{%- endif -%}
  {%- endif -%}
  {%- for item in cart.items -%}
    {%- assign b = item.product.metafields["$app:deposit"].bottles.value -%}
    {%- if b > 0 -%}"{{ item.product_id }}":{{ b }},{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<script id="deposit-bottles" type="application/json">{ {{- deposit_bottles | strip | remove_last: "," -}} }</script>

{%- comment -%}
  Per-drink deposit style: each drink's own deposit variant
  ($app:deposit.deposit_variant), for the current product and cart lines.
{%- endcomment -%}
{%- capture deposit_variants -%}
  {%- if product -%}
    {%- assign v = product.metafields["$app:deposit"].deposit_variant.value -%}
    {%- if v > 0 -%}"{{ product.id }}":{{ v }},{%- endif -%}
  {%- endif -%}
  {%- for item in cart.items -%}
    {%- assign v = item.product.metafields["$app:deposit"].deposit_variant.value -%}
    {%- if v > 0 -%}"{{ item.product_id }}":{{ v }},{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<script id="deposit-variants" type="application/json">{ {{- deposit_variants | strip | remove_last: "," -}} }</script>

{%- comment -%}
  Standalone deposit lines in the cart. In expand mode (or with the
  deposit disabled) they'd be charged on top — the script removes them.
{%- endcomment -%}
{%- capture deposit_leftovers -%}
  {%- for item in cart.items -%}
    {%- if deposit_config.depositVariantId and item.variant_id == deposit_config.depositVariantId -%}{{ item.key | json }},{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<script id="deposit-leftover-lines" type="application/json">[ {{- deposit_leftovers | strip | remove_last: "," -}} ]</script>

<script src="{{ 'deposit-embed.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Deposit Price Display",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "price_selector",
      "label": "Price element selector (optional)",
      "info": "Leave empty — prices are detected automatically on any theme. Set a CSS selector (e.g. .price-item--sale, .money) only if the deposit text appears in the wrong place."
    }
  ]
}
{% endschema %}
