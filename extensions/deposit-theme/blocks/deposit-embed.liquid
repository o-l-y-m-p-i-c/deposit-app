{% comment %}
  Deposit app embed block — injects the deposit price script globally.
  This script finds price elements on the storefront and appends deposit text
  only to eligible products. Activated from Theme Settings > App embeds.
  Display only: the deposit is charged by the Cart Transform, so the cart
  and checkout need no storefront code.
{% endcomment %}

{%- assign deposit_config = app.metafields["$app:deposit"]["display-config"].value -%}
<script id="deposit-config" type="application/json">{{ deposit_config | json }}</script>
{%- comment -%}
  Money formats tell deposit-embed.js which currency markers the theme
  renders next to prices; price_selector optionally pins the element.
{%- endcomment -%}
<script id="deposit-theme-settings" type="application/json">
  {
    "moneyFormats": [{{ shop.money_format | json }}, {{ shop.money_with_currency_format | json }}],
    "priceSelector": {{ block.settings.price_selector | default: "" | json }}
  }
</script>

{%- comment -%}
  Seed deposit units for the current product from the
  $app:deposit.bottles metafield, so the script needs no proxy call for
  it. Only positive values are emitted — a product missing here is
  looked up through the app proxy, never assumed deposit-free.
{%- endcomment -%}
{%- capture deposit_bottles -%}
  {%- if product -%}
    {%- assign b = product.metafields["$app:deposit"].bottles.value -%}
    {%- if b > 0 -%}"{{ product.id }}":{{ b }}{%- endif -%}
  {%- endif -%}
{%- endcapture -%}
<script id="deposit-bottles" type="application/json">{ {{- deposit_bottles | strip -}} }</script>

{%- comment -%}
  Standalone deposit lines left over from the retired "line" mode would
  be charged on top of the bundled deposit — the script removes them.
{%- endcomment -%}
{%- capture deposit_leftovers -%}
  {%- for item in cart.items -%}
    {%- if deposit_config.depositVariantId and item.variant_id == deposit_config.depositVariantId -%}{{ item.key | json }},{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<script id="deposit-leftover-lines" type="application/json">[ {{- deposit_leftovers | strip | remove_last: "," -}} ]</script>

<script src="{{ 'deposit-embed.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Deposit Price Display",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "price_selector",
      "label": "Price element selector (optional)",
      "info": "Leave empty — prices are detected automatically on any theme. Set a CSS selector (e.g. .price-item--sale, .money) only if the deposit text appears in the wrong place."
    }
  ]
}
{% endschema %}
