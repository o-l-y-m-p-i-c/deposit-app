{% comment %}
  Deposit app embed block — injects the deposit price script globally.
  This script finds price elements on the storefront and appends deposit text
  only to eligible products. Activated from Theme Settings > App embeds.
{% endcomment %}

{%- assign deposit_config = app.metafields["$app:deposit"]["display-config"].value -%}
<script id="deposit-config" type="application/json">{{ deposit_config | json }}</script>
{%- comment -%}
  Money formats tell deposit-embed.js which currency markers the theme
  renders next to prices; price_selector optionally pins the element.
{%- endcomment -%}
<script id="deposit-theme-settings" type="application/json">
  {
    "moneyFormats": [{{ shop.money_format | json }}, {{ shop.money_with_currency_format | json }}],
    "priceSelector": {{ block.settings.price_selector | default: "" | json }}
  }
</script>

{%- if deposit_config.enabled and deposit_config.depositVariantId -%}
{%- comment -%}
  Hide deposit-line controls at parse time — before deposit-embed.js
  loads — so they never flash on first render or section re-render.
  Only when enabled: the script exits early when disabled and would
  never lift the loading overlay below.
{%- endcomment -%}
<script>
  // Inline failsafe: lift the loading overlay even if deposit-embed.js
  // is blocked, fails to load, or throws before its own failsafe runs
  setTimeout(function () {
    document.documentElement.classList.add("deposit-ready");
  }, 4000);
</script>
<style>
  quantity-input[data-quantity-variant-id="{{ deposit_config.depositVariantId }}"],
  quantity-input[data-quantity-variant-id="{{ deposit_config.depositVariantId }}"] ~ cart-remove-button,
  quantity-input[data-quantity-variant-id="{{ deposit_config.depositVariantId }}"] ~ .quantity-popover__info-button,
  quantity-input[data-quantity-variant-id="{{ deposit_config.depositVariantId }}"] ~ .cart-items__info,
  .quantity-popover-container:has(quantity-input[data-quantity-variant-id="{{ deposit_config.depositVariantId }}"]),
  quantity-popover:has(quantity-input[data-quantity-variant-id="{{ deposit_config.depositVariantId }}"]),
  .quantity-popover-wrapper:has(quantity-input[data-quantity-variant-id="{{ deposit_config.depositVariantId }}"]),
  tr:has(quantity-input[data-quantity-variant-id="{{ deposit_config.depositVariantId }}"]) cart-remove-button {
    display: none !important;
  }

  /* Loading state while deposit-embed.js hasn't run its first sync
     yet — lifted when the script sets html.deposit-ready */
  @keyframes deposit-spin { to { transform: rotate(360deg); } }

  /* Header cart bubble: number hidden, spinner inside the bubble */
  html:not(.deposit-ready) .cart-count-bubble > span { visibility: hidden !important; }
  html:not(.deposit-ready) .cart-count-bubble::after {
    content: ""; position: absolute; top: 50%; left: 50%;
    width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,.4); border-top-color: currentColor;
    animation: deposit-spin .8s linear infinite;
  }

  /* Cart page: overlay only the items table (.cart__contents) */
  html:not(.deposit-ready) .cart__contents,
  html:not(.deposit-ready) cart-drawer-items { position: relative; }
  html:not(.deposit-ready) .cart__contents::after,
  html:not(.deposit-ready) cart-drawer-items::after {
    content: ""; position: absolute; inset: 0; z-index: 10;
    background: rgba(255,255,255,.55); pointer-events: all;
  }
  html:not(.deposit-ready) .cart__contents::before,
  html:not(.deposit-ready) cart-drawer-items::before {
    content: ""; position: absolute; z-index: 11;
    top: 50%; left: 50%; margin: -13px 0 0 -13px;
    width: 26px; height: 26px; border-radius: 50%;
    border: 3px solid rgba(0,0,0,.12); border-top-color: rgba(0,0,0,.55);
    animation: deposit-spin .8s linear infinite;
  }
</style>
{%- endif -%}

{%- if request.page_type == "product" -%}
  <script id="deposit-product-tags" type="application/json">{{ product.tags | json }}</script>
{%- endif -%}

<script src="{{ 'deposit-embed.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Deposit Price Display",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "price_selector",
      "label": "Price element selector (optional)",
      "info": "Leave empty — prices are detected automatically on any theme. Set a CSS selector (e.g. .price-item--sale, .money) only if the deposit text appears in the wrong place."
    }
  ]
}
{% endschema %}
