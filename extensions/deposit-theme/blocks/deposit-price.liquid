{% comment %}
  Deposit price block — shows "+ €0.10 per bottle" next to product price.
  Rendered server-side (no JS): eligibility is the product's
  $app:deposit.bottles metafield, written by the app's rule sync — the
  same data checkout uses. Works on any Online Store 2.0 theme.
  Add this block to the product information section in the theme editor.
{% endcomment %}

{%- assign config = app.metafields["$app:deposit"]["display-config"].value -%}
{%- assign bottles = product.metafields["$app:deposit"].bottles.value | default: 0 -%}
{%- if config.enabled and bottles > 0 -%}
  {%- assign deposit_minor = config.amountMinor | default: 10 | times: bottles -%}
  <div class="deposit-price-display" data-deposit-block data-deposit-eligible="true">
    <span class="deposit-price-text">
      {%- comment -%}
        The deposit is configured in the shop currency. Liquid can't
        convert raw amounts, so other presentment currencies show the
        shop-currency amount with its code.
      {%- endcomment -%}
      {%- if cart.currency.iso_code == shop.currency -%}
        + {{ deposit_minor | money }}
      {%- else -%}
        + {{ deposit_minor | divided_by: 100.0 | round: 2 }} {{ shop.currency }}
      {%- endif -%}
      {%- if bottles > 1 %} deposit ({{ bottles }} bottles){% else %} per bottle{% endif -%}
    </span>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Deposit Price",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [],
  "stylesheet": "deposit-price.css"
}
{% endschema %}
