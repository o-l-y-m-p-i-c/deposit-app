// Prisma schema for Bottle Deposit App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify OAuth sessions (required by @shopify/shopify-app-session-storage-prisma)
model Session {
  id               String   @id
  shop             String
  state            String
  isOnline         Boolean  @default(false)
  scope            String?
  expires          DateTime?
  expiresAt        DateTime?
  accessToken      String
  userId           BigInt?
  firstName        String?
  lastName         String?
  email            String?
  accountOwner     Boolean?
  locale           String?
  collaborator     Boolean?
  emailVerified    Boolean?
  onlineAccessInfo Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop])
}

// App settings per shop
model DepositSettings {
  id                Int      @id @default(autoincrement())
  shopId            String   @unique
  enabled           Boolean  @default(true)
  amountMinor       Int      @default(10) // in cents (10 = 0.10 EUR)
  currencyCode      String   @default("EUR")
  depositProductId  String?  // Shopify product GID
  depositVariantId  String?  // Shopify variant GID
  cartTransformId   String?  // Shopify cart transform GID
  validationId      String?  // Shopify validation GID
  depositMode       String   @default("expand") // set to "line" by every sync: the deposit is a separate cart line ("expand" bundling retired)
  depositStyle      String   @default("shared") // "shared" = one "Bottle Deposit" product | "per_product" = "Deposit – <drink>" product per drink
  bottleCountMode   String   @default("single") // "single" | "metafield"
  bottleCountKey    String?  // metafield key for bottle count, e.g. "bottles_per_unit"
  lastSyncedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Deposit rules — include or exclude by tag or collection
model DepositRule {
  id           Int      @id @default(autoincrement())
  shopId       String
  effect       String   // "INCLUDE" | "EXCLUDE"
  resourceType String   // "TAG" | "COLLECTION"
  resourceId   String?  // GraphQL ID for collections, null for tags
  value        String   // normalized tag text or collection title
  label        String   // display name
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shopId])
  @@unique([shopId, effect, resourceType, value])
}

// Sync log — track configuration sync operations
model SyncLog {
  id        Int      @id @default(autoincrement())
  shopId    String
  operation String   // "create_deposit_product" | "update_deposit_price" | "create_cart_transform" | "sync_metafields" | etc.
  status    String   // "success" | "error"
  message   String
  createdAt DateTime @default(now())

  @@index([shopId])
}

// Products that carry a deposit — mirror of the $app:deposit.bottles
// product metafield. Lets syncs diff instead of rescanning the catalog
// and serves the storefront eligibility app proxy.
model DepositProduct {
  shopId    String
  productId String   // numeric Shopify product ID (as in storefront JSON)
  bottles   Int      @default(1) // deposit units per product unit
  updatedAt DateTime @updatedAt

  @@id([shopId, productId])
}

// Billing state per shop — cached so storefront requests (app proxy) and
// the hourly access sweep can check access without the Admin API.
model ShopBilling {
  id                 Int       @id @default(autoincrement())
  shopId             String    @unique
  trialStartedAt     DateTime  @default(now()) // copied from ShopTrial
  isDevStore         Boolean   @default(false)
  subscriptionId     String?   // active Shopify AppSubscription GID
  subscriptionStatus String?   // ACTIVE | PENDING | CANCELLED | ...
  currentPeriodEnd   DateTime?
  lastSyncedAt       DateTime?
  syncedAccess       Boolean?  // access state the deposit config was last synced with
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Trial start per shop. Never deleted on uninstall, so reinstalling the
// app doesn't grant a second free trial.
model ShopTrial {
  shopId         String   @id
  trialStartedAt DateTime @default(now())
  devStore       Boolean  @default(false) // last known development-store status
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Shopify app subscriptions (charges) the shop has created
model BillingSubscription {
  id               String    @id // Shopify AppSubscription GID
  shopId           String
  name             String
  status           String
  test             Boolean   @default(false)
  trialDays        Int       @default(0)
  amount           Int       // in cents
  currencyCode     String
  createdAt        DateTime
  currentPeriodEnd DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([shopId])
}

// Per-drink deposit products ("Deposit – <drink title>") created by the
// app in the "per_product" deposit style. Archived (not deleted) when a
// drink loses its deposit or the style switches back to "shared".
model DepositItem {
  shopId          String
  sourceProductId String   // numeric ID of the drink
  productId       String   // numeric ID of its deposit product
  variantId       String   // numeric ID of the deposit product's variant
  title           String
  priceMinor      Int
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@id([shopId, sourceProductId])
}
