# App
PORT=3000
NODE_ENV=development

# Database
# Dev: SQLite (local only, do not use in production)
DATABASE_URL="file:./dev.db"
# Production: Neon Postgres (pooled for app, unpooled for migrations)
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Shopify App credentials (from Partner Dashboard)
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_APP_URL=https://your-app-url.ngrok.io

# Scopes
# read_products,write_products — manage products + hidden deposit product
# write_cart_transforms — create and manage Cart Transform Function
# read_metaobjects,write_metaobjects — app-owned metafields for Function config
# read_orders — verify deposit appears in orders
# read_themes — detect app embed activation status
SCOPES=read_products,write_products,write_cart_transforms,read_metaobjects,write_metaobjects,read_orders,read_themes

# Webhook secret (from Partner Dashboard > App setup > Webhooks)
WEBHOOK_SECRET=your_webhook_secret
